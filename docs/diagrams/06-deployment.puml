@startuml 06-deployment
title 06 Deployment: one developer machine

node "Developer machine" {
  node "Browser" as browser
  node "curl or a local sender" as sender

  frame "Dev mode: uv run reflex run" {
    node "Frontend dev server\n(React Router, Vite)\nport 17300" as devserver {
      artifact "Reflex frontend" as frontend_dev
    }
    node "Python 3.14 process\n(Granian, one worker)\nport 17301" as backend_dev {
      component "ApiFirst" as first_dev
      component "Reflex backend" as reflex_dev
      component "FastAPI app" as api_dev
    }
  }

  frame "Production mode: uv run reflex run ~--env prod ~--backend-port 17300" {
    node "Python 3.14 process\n(Granian; one worker, or several\nwhen REFLEX_REDIS_URL is set)\nport 17300" as backend_prod {
      artifact "Built frontend files" as frontend_prod
      component "ApiFirst" as first_prod
      component "Reflex backend" as reflex_prod
      component "FastAPI app" as api_prod
    }
  }

  folder "data/" {
    database "webhook_studio.db\n(SQLite, WAL)" as sqlite
  }
  node "uv run alembic upgrade head" as migrate
}

node "PostgreSQL server\n(optional, with uv sync ~--extra postgres)" as postgres {
  database "bin, captured_request" as pg_tables
}

node "Redis server\n(optional, REFLEX_REDIS_URL)" as redis {
  database "Reflex page state\nwebhook-studio:bin:* channels" as redis_data
}

browser --> devserver : HTTP, page
browser --> first_dev : WebSocket /_event,\nHTTP /api/v1
sender --> first_dev : HTTP /api/webhook
first_dev --> reflex_dev
first_dev --> api_dev
browser --> first_prod : HTTP and WebSocket,\npage, /_event and /api/v1
sender --> first_prod : HTTP /api/webhook
first_prod --> reflex_prod
first_prod --> api_prod
api_dev --> sqlite : aiosqlite
api_prod --> sqlite : aiosqlite
migrate --> sqlite : creates the tables
api_dev ..> postgres : psycopg, when\nWEBHOOK_STUDIO_DATABASE_URL\nis postgresql+psycopg://
api_prod ..> postgres : psycopg
migrate ..> postgres
reflex_prod ..> redis : state, events
api_prod ..> redis : publish events

@enduml

@startuml 13-activity-capture
title 13 Capture checks, in order

start
:A request reaches /api/webhook/{bin_id} or a path under it;
if (Method is GET, HEAD, POST, PUT, PATCH, DELETE or OPTIONS?) then (no)
  :Reply 405 problem, Allow lists the 7 methods;
  :Nothing is stored;
else (yes)
  if (bin_id is 22 URL-safe characters?) then (no)
    :Reply 404 problem;
    :The database is not touched;
  else (yes)
    :Stream the body;
    if (Body passes WEBHOOK_STUDIO_MAX_BODY_BYTES?) then (yes)
      :Stop reading, keep no body,
      body_truncated = true, reply_status = 413;
    else (no)
      if (CORS on, OPTIONS and Access-Control-Request-Method set?) then (yes)
        :It is a preflight, reply_status = 204;
      else (no)
        :reply_status = 200;
      endif
    endif
    :Begin one transaction;
    if (A bin has this id?) then (no)
      :Roll back;
      :Reply 404 problem;
    else (yes)
      :Insert the request;
      :Delete the oldest past WEBHOOK_STUDIO_MAX_REQUESTS_PER_BIN;
      :Set last_activity_at and expires_at on the bin;
      :Commit;
      switch (reply_status)
      case (413)
        :Reply 413 problem with request_id;
      case (204)
        :Reply 204, echo the requested
        method and headers;
      case (200)
        if (HEAD?) then (yes)
          :Reply 200 with no body;
        else (no)
          :Reply 200 {"ok": true, "request_id": ...};
        endif
      endswitch
    endif
  endif
endif
:Add Content-Security-Policy: sandbox and X-Content-Type-Options: nosniff;
if (WEBHOOK_STUDIO_CORS_ENABLED?) then (true)
  :Add Access-Control-Allow-Origin: *;
else (false)
endif
stop
@enduml

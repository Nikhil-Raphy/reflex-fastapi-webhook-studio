@startuml 02-c4-container
!include <C4/C4_Container>

title 02 Containers: Reflex FastAPI Webhook Studio

Person(developer, "Developer", "Opens the app in a browser and calls the REST API.")
System_Ext(sender, "Sender", "A webhook service, a web page or curl.")
System_Ext(target, "Replay target", "An HTTP service a request is replayed to.")

System_Boundary(studio, "Reflex FastAPI Webhook Studio") {
  Container(frontend, "Reflex frontend", "React app that Reflex generates from Python", "The home page and each bin's page, kept live over the websocket.")
  Container(caddy, "Caddy (Docker only)", "Caddy 2, port 17300", "Serves the built frontend, and passes /api, /_event and Reflex's other routes to the workers.")
  Container(worker, "Worker process (one, or several with Redis)", "Python 3.14, Granian, Reflex 0.10, FastAPI", "ApiFirst sends each request under /api to the FastAPI app, and the rest to the Reflex backend. Runs a watch task per open bin page and the expiry sweeper. Outside Docker, production mode also serves the built frontend.")
  ContainerDb(database, "Database", "SQLite file data/webhook_studio.db, or PostgreSQL", "Holds the bin and captured_request tables, which Alembic creates.")
  ContainerDb(redis, "Redis (optional; always in Docker)", "Set by REFLEX_REDIS_URL", "Reflex page state, and the pub/sub channels webhook-studio:bin:* that carry events between workers.")
}

Rel(developer, frontend, "Makes bins and watches requests", "HTTP")
Rel(frontend, caddy, "Sends events, gets state", "WebSocket /_event")
Rel(caddy, worker, "Passes backend routes", "HTTP, WebSocket")
Rel(frontend, worker, "Sends events, gets state (outside Docker)", "WebSocket /_event")
Rel(developer, worker, "Scripts bins and requests", "HTTP, JSON, /api/v1")
Rel(sender, worker, "Sends requests to a bin", "HTTP, /api/webhook/{bin_id}/...")
Rel(worker, target, "Replays a request", "HTTP or HTTPS, address checked")
Rel(worker, database, "Reads and writes", "SQLAlchemy async: aiosqlite or psycopg")
Rel(worker, redis, "Keeps state, publishes and hears bin events", "Redis protocol")

SHOW_LEGEND()
@enduml

@startuml 04-c4-component
!include <C4/C4_Component>

title 04 Components: worker process

Person(developer, "Developer", "Calls the REST API.")
System_Ext(sender, "Sender", "A webhook service, a web page or curl.")
Container(frontend, "Reflex frontend", "React app that Reflex generates from Python", "Shows the home page.")
ContainerDb(database, "Database", "SQLite or PostgreSQL", "bin and captured_request tables")

Container_Boundary(worker, "Worker process") {
  Component(entry, "reflex_fastapi_webhook_studio.py", "Reflex StudioApp", "Reads settings, sets up logging, builds the Database and create_api(). StudioApp.~__call~__ returns ApiFirst(api, Reflex app). Adds the index page and registers database.lifespan.")
  Component(apifirst, "api/app.py: ApiFirst", "ASGI", "Sends HTTP requests for /api and paths under it to FastAPI. Sends the rest, with lifespan and websocket traffic, to Reflex.")
  Component(fastapi, "api/app.py: create_api()", "FastAPI", "Adds the problem handlers, CaptureReplyHeaders and the routers. Serves /api/docs and /api/openapi.json. health_router() serves GET /api/v1/health.")
  Component(capture_api, "api/capture.py", "FastAPI router", "capture_router(): any of 7 methods on /api/webhook/{bin_id} and paths under it. read_body() stops at the cap. CaptureReplyHeaders adds CSP sandbox, nosniff and CORS.")
  Component(bins_api, "api/bins.py", "FastAPI router", "bins_router(): POST /api/v1/bins, GET and PATCH /api/v1/bins/{bin_id}.")
  Component(requests_api, "api/requests.py", "FastAPI router", "requests_router(): GET /api/v1/bins/{bin_id}/requests and /requests/{request_id}.")
  Component(problems, "api/problems.py, api/schemas.py", "FastAPI, Pydantic", "problem() builds RFC 9457 replies. Pydantic bodies: BinCreate, BinUpdate, RequestDetailOut, HealthOut, CaptureOut.")
  Component(capture_svc, "services/capture.py", "CaptureService", "capture(): stores a request, trims the bin and moves its expiry, in one transaction.")
  Component(bins_svc, "services/bins.py", "BinService", "create(), get(), rename(). Enforces WEBHOOK_STUDIO_MAX_BINS.")
  Component(requests_svc, "services/requests.py", "RequestService", "list(), get().")
  Component(repository, "db/repository.py", "SQLModel, async", "Takes a session; returns domain dataclasses, never rows.")
  Component(models, "db/models.py", "SQLModel tables", "BinRow, CapturedRequestRow, UtcDateTime.")
  Component(engine, "db/engine.py", "SQLAlchemy async", "Database: engine, sessions, check(), lifespan(). Sets the SQLite pragmas.")
  Component(domain, "domain.py", "Frozen dataclasses", "Bin, IncomingRequest, RequestSummary, CapturedRequest, HttpMethod and the errors.")
  Component(settings, "settings.py", "Frozen dataclass", "get_settings() reads WEBHOOK_STUDIO_* once and stops on a bad value.")
  Component(log_config, "log_config.py", "stdlib logging", "configure_logging(): one JSON line per record. short_id() shows 6 characters of a bin id.")
  Component(package, "~__init~__.py", "Python package", "Sets ~__version~__ from the installed package metadata, which comes from pyproject.toml.")
  Component(runtime, "Reflex runtime", "Reflex 0.10", "Serves /_event and /ping, and runs state and lifespan tasks.")
}

Rel(sender, apifirst, "Sends requests to a bin", "HTTP /api/webhook")
Rel(developer, apifirst, "Calls the REST API", "HTTP /api/v1")
Rel(frontend, apifirst, "Sends events, gets state", "WebSocket /_event")
Rel(entry, apifirst, "Returns from StudioApp.~__call~__")
Rel(entry, settings, "Calls get_settings()")
Rel(entry, log_config, "Calls configure_logging()")
Rel(apifirst, fastapi, "Paths under /api")
Rel(apifirst, runtime, "Every other path")
Rel(runtime, engine, "Runs database.lifespan")
Rel(fastapi, capture_api, "Includes")
Rel(fastapi, bins_api, "Includes")
Rel(fastapi, requests_api, "Includes")
Rel(fastapi, package, "Reads ~__version~__")
Rel(capture_api, problems, "Uses")
Rel(capture_api, capture_svc, "Calls capture()")
Rel(bins_api, bins_svc, "Calls")
Rel(requests_api, requests_svc, "Calls")
Rel(capture_svc, repository, "Calls")
Rel(bins_svc, repository, "Calls")
Rel(requests_svc, repository, "Calls")
Rel(repository, models, "Reads and writes rows")
Rel(repository, domain, "Returns")
Rel(engine, database, "Connects", "aiosqlite or psycopg")

SHOW_LEGEND()
@enduml

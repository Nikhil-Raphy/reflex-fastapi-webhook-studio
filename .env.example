# Copy this file to .env, change what you need, then load it into your shell before you start the app:
#   set -a; . ./.env; set +a
# Each value below is the default.

# Async SQLAlchemy URL of the database. SQLite needs nothing more.
WEBHOOK_STUDIO_DATABASE_URL=sqlite+aiosqlite:///data/webhook_studio.db
# For PostgreSQL, run `uv sync --extra postgres` and use a URL like this one:
# WEBHOOK_STUDIO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/webhook_studio

# Add `Access-Control-Allow-Origin: *` to capture replies, and answer browser preflights. true or false.
WEBHOOK_STUDIO_CORS_ENABLED=true

# Largest request body to store, in bytes. A bigger body gets a 413 reply, and the request is kept without it.
WEBHOOK_STUDIO_MAX_BODY_BYTES=1048576

# Most requests a bin keeps. Each new request past this drops the oldest.
WEBHOOK_STUDIO_MAX_REQUESTS_PER_BIN=500

# Most bins the app holds. Creating one more gets a 409 reply.
WEBHOOK_STUDIO_MAX_BINS=1000

# Days a bin lives after its last captured request. Expired bins are deleted on a timer.
WEBHOOK_STUDIO_BIN_TTL_DAYS=7

# Seconds between deletes of expired bins. Each worker deletes them, at a slightly random time.
WEBHOOK_STUDIO_SWEEP_INTERVAL_S=3600

# Longest reply delay a bin may set, in milliseconds.
WEBHOOK_STUDIO_MAX_DELAY_MS=30000

# Which addresses a replay may reach: restricted (public internet addresses only) or local (any address, this
# machine and private networks included). Use local only where you trust everyone who can open the pages.
WEBHOOK_STUDIO_REPLAY_MODE=restricted

# Seconds a replay may take in all.
WEBHOOK_STUDIO_REPLAY_TIMEOUT_S=15

# The scheme and host that senders use, such as https://hooks.example.com, when the app runs behind a proxy.
# Capture URLs and curl commands use it. Empty means the app's own address.
WEBHOOK_STUDIO_PUBLIC_BASE_URL=

# Which bins the home page lists: browser (the ones made in this browser) or all (every bin; anyone who can open
# the home page then sees every bin id).
WEBHOOK_STUDIO_BIN_LISTING=browser

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
WEBHOOK_STUDIO_LOG_LEVEL=INFO

# Reflex's Redis. When set, Reflex keeps page state in Redis and can run several workers, and live updates travel
# through the same Redis. Unset by default.
# REFLEX_REDIS_URL=redis://localhost:6379/0

# Docker only: compose.yaml reads the values below.

# Password of the PostgreSQL database that compose starts. Required. Letters and digits only, as it goes into a URL.
POSTGRES_PASSWORD=

# The address people open in a browser. The image is built with it, so rebuild after you change it.
APP_URL=http://localhost:17300

# Where compose publishes the app. 127.0.0.1 keeps it on this machine; put a proxy in front to reach it from others.
APP_BIND=127.0.0.1
APP_PORT=17300

# Backend workers. When unset, Reflex picks a number from the CPU count.
# GRANIAN_WORKERS=3
